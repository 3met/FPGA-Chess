    },
    "uart-primitives": {
      "source_set": "uart",
      "testbench": "hardware/tb/tb_uart_primitives.sv",
      "top": "tb_uart_primitives"
    },
    "rx-decode": {
      "source_set": "uart",
      "testbench": "hardware/tb/tb_rx_decode.sv",
      "top": "tb_rx_decode"
    },
    "tx-encode": {
      "source_set": "uart",
