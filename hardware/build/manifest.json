  "generated_data": {
    "pst-values": {
      "script": "hardware/scripts/generate_pst_values.py",
      "outputs": [
        "hardware/data/pst_values/pst_values.hex",
        "hardware/rtl/generated/evaluation_parameters.svh"
      ]
    },
    "nnue-defaults": {
      "script": "hardware/scripts/generate_nnue_defaults.py",
      "outputs": [
        "hardware/data/nnue/feature_transformer.hex",
        "hardware/data/nnue/output_weights.hex",
        "hardware/data/nnue/output_bias.hex",
        "hardware/data/nnue/accumulator_bias.hex"
      ]
    },
    "zobrist-values": {
      "script": "hardware/scripts/generate_zobrist_values.py",
      "outputs": [
        "hardware/data/zobrist/zobrist_values.hex",
        "hardware/rtl/generated/zobrist_values_pkg.sv"
      ]
    }
  },
  "synthesis_targets": {
    "quartus-de1-soc": {
      "tool": "quartus",
      "top": "de1_soc",
      "source_set": "quartus-de1-soc",
      "family": "Cyclone V",
      "device": "5CSEMA5F31C6",
      "engine_config": "hardware/config/engine/de1-soc.json",
      "clock_generator": {
        "kind": "intel-pll",
        "template": "hardware/ip/pll"
      },
      "seed": 8,
      "map_effort": "auto",
      "map_optimization": "speed",
      "fit_effort": "standard",
      "message_disable": [10008, 10264, 12021, 12022, 12128, 12130, 12133, 12134, 144001, 169065, 169070, 286033, 292013, 334003, 334004],
      "sdc": "hardware/constraints/engine.sdc",
      "qsf_template": "hardware/constraints/DE1_SoC.qsf",
      "qip_files": []
    },
    "vivado-generic": {
      "tool": "vivado",
      "top": "board_update_pipeline",
      "source_set": "vivado-generic",
      "seed": 1,
      "clock_port": "clk",
      "clock_period_ns": 10.0
    },
    "vivado-nnue": {
      "tool": "vivado",
      "top": "nnue_evaluator",
      "source_set": "vivado-nnue",
      "seed": 1,
      "clock_port": "clk",
      "clock_period_ns": 25.0
    }
  },
  "programming_targets": {
    "quartus-de1-soc": {
      "tool": "quartus",
      "synthesis_target": "quartus-de1-soc",
      "artifact": "work/build/quartus-de1-soc/fpga_chess.sof",
      "mode": "jtag",
      "jtag_id": "02D120DD"
    }
  }
