{
  "schema_version": 1,
  "simulator": {
    "modelsim": {
      "vlog_args": ["-sv"],
      "vsim_args": ["-c", "-t", "ns"],
      "run_do": "run -all; quit -f"
    }
  },
  "source_sets": {
    "common": [
      "hardware/rtl/defs.sv",
      "hardware/rtl/helper_functions.sv"
    ],
    "async-fifo": [
      "hardware/rtl/memory/async_fifo.sv"
    ],
    "uart": [
      "@common",
      "@async-fifo",
      "hardware/rtl/rx_decode.sv",
      "hardware/rtl/tx_encode.sv"
    ],
    "static-evaluator": [
      "@common",
      "hardware/rtl/static_evaluator/defs.sv",
      "hardware/rtl/static_evaluator/static_evaluator.sv"
    ],
    "move-generator": [
      "@common",
      "hardware/rtl/move_generator/defs.sv",
      "hardware/rtl/move_generator/get_move_dir.sv",
      "hardware/rtl/move_generator/move_generator_tile_PE.sv",
      "hardware/rtl/move_generator/move_generator.sv"
    ],
    "board-update-pipeline": [
      "@common",
      "hardware/rtl/zobrist_defs.sv",
      "hardware/rtl/board_update_pipeline/board_update_pipeline_defs.sv",
      "hardware/rtl/memory/simple_dual_port_ram.sv",
      "hardware/rtl/memory/inferred_dual_port_rom.sv",
      "hardware/rtl/board_update_pipeline/board_update_pipeline.sv"
    ],
    "tt-load-store": [
      "@common",
      "hardware/rtl/tt/tt_defs.sv",
      "hardware/rtl/tt/tt_load_store.sv"
    ],
    "search-controller": [
      "@common",
      "@board-update-pipeline",
      "@move-generator",
      "@static-evaluator",
      "@tt-load-store",
      "hardware/rtl/engine_defs.sv",
      "hardware/rtl/timer.sv",
      "hardware/rtl/search_controller.sv"
    ],
    "engine-rtl": [
      "@common",
      "hardware/rtl/board_update_pipeline/board_update_pipeline_defs.sv",
      "hardware/rtl/engine_defs.sv",
      "hardware/rtl/engine.sv"
    ],
    "engine": [
      "@engine-rtl",
      "hardware/rtl/search_controller_stub.sv"
    ],
    "portable-rtl": [
      "@uart",
      "@static-evaluator",
      "@move-generator",
      "@board-update-pipeline",
      "@tt-load-store",
      "@search-controller",
      "@engine-rtl"
    ],
    "quartus-de1-soc": [
      "@portable-rtl",
      "hardware/rtl/main.sv"
    ],
    "vivado-generic": [
      "@portable-rtl"
    ]
  },
  "tests": {
    "board-update-pipeline": {
      "source_set": "board-update-pipeline",
      "testbench": "hardware/tb/board_update_pipeline/tb_board_update_pipeline.sv",
      "top": "tb_board_update_pipeline"
    },
    "move-generator": {
      "source_set": "move-generator",
      "testbench": "hardware/tb/move_generator/tb_move_generator.sv",
      "top": "tb_move_generator"
    },
    "static-evaluator": {
      "source_set": "static-evaluator",
      "testbench": "hardware/tb/static_evaluator/tb_static_evaluator.sv",
      "top": "tb_static_evaluator"
    },
    "tt-load-store": {
      "source_set": "tt-load-store",
      "testbench": "hardware/tb/tt/tb_tt_load_store.sv",
      "top": "tb_tt_load_store"
    },
    "async-fifo": {
      "source_set": "async-fifo",
      "testbench": "hardware/tb/tb_async_fifo.sv",
      "top": "tb_async_fifo"
    },
    "uart-primitives": {
      "source_set": "uart",
      "testbench": "hardware/tb/tb_rx_decode.sv",
      "top": "tb_uart_primitives"
    },
    "rx-decode": {
      "source_set": "uart",
      "testbench": "hardware/tb/tb_rx_wrapper.sv",
      "top": "tb_rx_decode"
    },
    "tx-encode": {
      "source_set": "uart",
      "testbench": "hardware/tb/tb_tx_encode.sv",
      "top": "tb_tx_encode"
    },
    "engine": {
      "source_set": "engine",
      "testbench": "hardware/tb/tb_engine.sv",
      "top": "tb_engine"
    },
    "search-controller": {
      "source_set": "search-controller",
      "testbench": "hardware/tb/tb_search_controller.sv",
      "top": "tb_search_controller"
    }
  },
  "generated_data": {
    "pst-values": {
      "script": "hardware/scripts/generate_pst_values.py",
      "outputs": ["hardware/data/pst_values/pst_values.hex"]
    },
    "zobrist-values": {
      "script": "hardware/scripts/generate_zobrist_values.py",
      "outputs": ["hardware/data/zobrist/zobrist_values.hex"]
    }
  },
  "synthesis_targets": {
    "quartus-de1-soc": {
      "tool": "quartus",
      "top": "main",
      "source_set": "quartus-de1-soc",
      "family": "Cyclone V",
      "device": "5CSEMA5F31C6",
      "sdc": "hardware/constraints/engine.sdc",
      "qsf_template": "hardware/constraints/DE1_SoC.qsf",
      "qip_files": [
        "hardware/ip/pll/pll_ip.qip"
      ]
    },
    "vivado-generic": {
      "tool": "vivado",
      "top": "board_update_pipeline",
      "source_set": "vivado-generic",
      "clock_port": "clk",
      "clock_period_ns": 10.0
    }
  }
}
