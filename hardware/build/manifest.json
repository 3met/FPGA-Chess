{
  "simulator": {
    "modelsim": {
      "vlog_args": ["-sv"],
      "vsim_args": ["-c", "-t", "ns"],
      "run_do": "run -all; quit -f"
    }
  },
  "source_sets": {
    "common": [
      "hardware/rtl/defs.sv",
      "hardware/rtl/helper_functions.sv"
    ],
    "async-fifo": [
      "hardware/rtl/memory/async_fifo.sv"
    ],
    "reset-control": [
      "hardware/rtl/reset_release.sv"
    ],
    "uart": [
      "@common",
      "@async-fifo",
      "hardware/rtl/rx_decode.sv",
      "hardware/rtl/tx_encode.sv"
    ],
    "nnue": [
      "@common",
      "hardware/rtl/nnue/defs.sv",
      "hardware/rtl/nnue/nnue_evaluator.sv"
    ],
    "move-generator": [
      "@common",
      "hardware/rtl/memory/sync_read_simple_dual_port_ram.sv",
      "hardware/rtl/move_generator/defs.sv",
      "hardware/rtl/move_generator/move_generator.sv"
    ],
    "board-update-pipeline": [
      "@common",
      "hardware/rtl/zobrist_defs.sv",
      "hardware/rtl/generated/zobrist_values_pkg.sv",
      "hardware/rtl/board_update_pipeline/board_update_pipeline_defs.sv",
      "hardware/rtl/memory/async_read_simple_dual_port_ram.sv",
      "hardware/rtl/memory/sync_read_dual_port_rom.sv",
      "hardware/rtl/board_update_pipeline/board_update_pipeline.sv"
    ],
    "tt-load-store": [
      "@common",
      "hardware/rtl/memory/sync_read_simple_dual_port_ram.sv",
      "hardware/rtl/memory/synchronous_fifo.sv",
      "hardware/rtl/tt/tt_defs.sv",
      "hardware/rtl/tt/tt_load_store.sv",
      "hardware/rtl/tt/tt_external_load_store.sv"
    ],
    "tt-sdram-controller": [
      "@common",
      "hardware/rtl/tt/tt_defs.sv",
      "hardware/rtl/memory/sdr_sdram_controller.sv"
    ],
    "repetition-checker": [
      "@common",
      "hardware/rtl/zobrist_defs.sv",
      "hardware/rtl/memory/sync_read_simple_dual_port_ram.sv",
      "hardware/rtl/repetition_checker.sv"
    ],
    "search-controller": [
      "@board-update-pipeline",
      "@move-generator",
      "@nnue",
      "@tt-load-store",
      "@repetition-checker",
      "hardware/rtl/engine_defs.sv",
      "hardware/rtl/timer.sv",
      "hardware/rtl/search_controller.sv"
    ],
    "engine-rtl": [
      "@common",
      "hardware/rtl/board_update_pipeline/board_update_pipeline_defs.sv",
      "hardware/rtl/engine_defs.sv",
      "hardware/rtl/engine_command_layer.sv",
      "hardware/rtl/engine.sv"
    ],
    "host-link": [
      "@uart",
      "@reset-control",
      "hardware/rtl/board_update_pipeline/board_update_pipeline_defs.sv",
      "hardware/rtl/engine_defs.sv",
      "hardware/rtl/engine_command_layer.sv"
    ],
    "engine": [
      "@search-controller",
      "@engine-rtl"
    ],
    "portable-rtl": [
      "@uart",
      "@search-controller",
      "@engine-rtl"
    ],
    "quartus-de1-soc": [
      "@portable-rtl",
      "hardware/rtl/reset_release.sv",
      "hardware/rtl/memory/tt_memory_cdc_bridge.sv",
      "hardware/rtl/memory/sdr_sdram_controller.sv",
      "hardware/rtl/de1_soc.sv"
    ],
    "vivado-generic": [
      "@portable-rtl"
    ],
    "vivado-nnue": [
      "@nnue"
    ],
    "engine-profile": [
      "@portable-rtl",
      "hardware/rtl/memory/tt_memory_cdc_bridge.sv",
      "hardware/rtl/memory/sdr_sdram_controller.sv",
      "hardware/tb/profile/sdram_chip_model.sv",
      "hardware/tb/profile/tb_engine_profile.sv"
    ]
  },
