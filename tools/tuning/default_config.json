{
  "dataset": {
    "path": "training-data/lichess_db_eval.jsonl.zst",
    "max_positions": 235000000,
    "num_workers": "auto",
    "progress_interval_seconds": 60
  },
  "filters": {
    "minimum_depth": 12,
    "max_evaluation_cp": 1700,
    "remove_in_check": true,
    "remove_captures": true,
    "remove_checks": false
  },
  "training": {
    "seed": 1,
    "accumulator_overflow_penalty": 0.0001,
    "batch_size": 8192,
    "microbatch_size": "auto",
    "validation_size": 1000000,
    "learning_rate": 0.005,
    "cosine_final_factor": 0.01,
    "max_steps": 350000,
    "score_probability_offset": 270.0,
    "score_probability_scale": 380.0,
    "weight_decay": 0.0,
    "gradient_clip": 1.0,
    "device": "auto",
    "cpu_threads": "auto",
    "shuffle_buffer": 262144,
    "compile": true,
    "amp": true,
    "validation_interval_steps": 5000,
    "checkpoint_interval_steps": 5000,
    "early_stopping_patience": 20
  },
  "output": {
    "root": "work/tuning"
  },
  "wandb": {
    "enabled": false,
    "required": false,
    "project": "fpga-chess-tuning",
    "entity": null,
    "mode": "online"
  }
}
